[sub_resource type="Shader" id="Shader_hit_flash"]
code = "shader_type canvas_item;\n\nuniform float flash_amount : hint_range(0.0, 1.0) = 0.0;\nuniform vec4 flash_color : source_color = vec4(1.0, 0.96, 0.78, 1.0);\n\nvoid fragment() {\n\tvec4 sprite_color = texture(TEXTURE, UV);\n\tsprite_color.rgb = mix(sprite_color.rgb, flash_color.rgb, flash_amount);\n\tCOLOR = sprite_color * COLOR;\n}\n"

